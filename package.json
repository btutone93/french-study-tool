{
  "name": "french-study-tool",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:start": "turbo run db:start --filter=@repo/db",
    "db:reset": "turbo run db:reset --filter=@repo/db && turbo run db:generate-types --filter=@repo/db",
    "db:generate-types": "turbo run db:generate-types --filter=@repo/db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jest": "^30",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.10.0"
  }
}
